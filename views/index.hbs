<div id="banner" class="container">
    <section>
        <p>This is <strong>{{banner.highlightText}}</strong>, {{banner.description}}</p>
        <a href="{{banner.buttonLink}}" class="button medium">{{banner.buttonText}}</a>
    </section>
</div>

<div id="extra">
    <div class="container">
        
        <div class="row no-collapse-1">
            {{#each featuredRow1}}
                <section class="4u">
                    <a href="{{this.buttonLink}}" class="image featured"><img src="{{this.image}}" alt="" width="368" height="160"></a>
                    <div class="box">
                        <p>{{this.description}}</p>
                        <a href="{{this.buttonLink}}" class="button">Read More</a>
                    </div>
                </section>
            {{/each}}
        </div>
        
        <div class="row no-collapse-1">
            {{#each featuredRow2}}
                <section class="4u">
                    <a href="{{this.buttonLink}}" class="image featured"><img src="{{this.image}}" alt="" width="368" height="160"></a>
                    <div class="box">
                        <p>{{this.description}}</p>
                        <a href="{{this.buttonLink}}" class="button">Read More</a>
                    </div>
                </section>
            {{/each}}
        </div>
        
    </div>
</div>

<div id="main">
    <div class="container">
        <div class="row"> 
            
            <div class="6u">
                <section>
                    <ul class="style">
                        {{#each mainLeftFeatures}}
                        <li class="fa {{this.iconClass}}">
                            <h3>{{this.title}}</h3>
                            <span>{{this.details}}</span>
                        </li>
                        {{/each}}
                    </ul>
                </section>
            </div>
            
            <div class="6u">
                <section>
                    <ul class="style">
                        {{#each mainRightFeatures}}
                        <li class="fa {{this.iconClass}}">
                            <h3>{{this.title}}</h3>
                            <span>{{this.details}}</span>
                        </li>
                        {{/each}}
                    </ul>
                </section>
            </div>
            
        </div>
    </div>
</div>